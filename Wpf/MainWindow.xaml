<Window x:Class="Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestiunea Jucatorilor" Height="780" Width="960"
        Background="#F4F4F8" ResizeMode="CanMinimize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#C8C8D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#444466"/>
            <Setter Property="Padding" Value="0,0,0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="ErrStyle">
            <Setter Property="Foreground" Value="#D0021B"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#33335A"/>
            <Setter Property="BorderBrush" Value="#C8C8D4"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Gestiunea Jucatorilor" FontSize="22" FontWeight="Bold" Foreground="#22224A"/>
            <TextBlock x:Name="txtSubtitle" Text="Completati campurile de mai jos pentru a adauga un jucator nou"
                       FontSize="12" Foreground="#7777AA" Margin="0,3,0,0"/>
            <Border Height="1" Background="#DDDDE8" Margin="0,10,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <GroupBox Header="Informatii de baza">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Label x:Name="lblNickname" Content="NICKNAME"/>
                            <TextBox x:Name="txtNickname"/>
                            <TextBlock x:Name="errNickname" Style="{StaticResource ErrStyle}" Text="Nickname invalid"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Label x:Name="lblHero" Content="EROU"/>
                            <ComboBox x:Name="cmbHero"/>
                            <TextBlock x:Name="errHero" Style="{StaticResource ErrStyle}" Text="Selectati un erou"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <Label Content="RANK"/>
                            <ComboBox x:Name="cmbRank"/>
                            <TextBlock x:Name="errRank" Style="{StaticResource ErrStyle}" Text="Selectati un rank"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Rol jucator">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <CheckBox x:Name="chkDps" Content="DPS" Checked="chkRole_Changed" Unchecked="chkRole_Changed"/>
                            <CheckBox x:Name="chkTank" Content="Tank" Checked="chkRole_Changed" Unchecked="chkRole_Changed"/>
                            <CheckBox x:Name="chkHealer" Content="Healer" Checked="chkRole_Changed" Unchecked="chkRole_Changed"/>
                        </StackPanel>
                        <TextBlock x:Name="errRole" Style="{StaticResource ErrStyle}" Text="Selectati cel putin un rol"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Statistici">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Label x:Name="lblGames" Content="MECIURI JUCATE"/>
                            <TextBox x:Name="txtGamesPlayed"/>
                            <TextBlock x:Name="errGamesPlayed" Style="{StaticResource ErrStyle}" Text="Minim 1 meci"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Label x:Name="lblDamage" Content="DAMAGE DEALT"/>
                            <TextBox x:Name="txtDamageDealt"/>
                            <TextBlock x:Name="errDamageDealt" Style="{StaticResource ErrStyle}" Text="Valoare invalida (min 0)"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <Label x:Name="lblHealing" Content="HEALING DONE"/>
                            <TextBox x:Name="txtHealingDone"/>
                            <TextBlock x:Name="errHealingDone" Style="{StaticResource ErrStyle}" Text="Valoare invalida (min 0)"/>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <Label x:Name="lblDamageTaken" Content="DAMAGE TAKEN"/>
                            <TextBox x:Name="txtDamageTaken"/>
                            <TextBlock x:Name="errDamageTaken" Style="{StaticResource ErrStyle}" Text="Valoare invalida (min 0)"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Lista jucatori adaugati">
                    <StackPanel>
                        <DataGrid x:Name="dgJucatori"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Height="160"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  FontSize="12"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F8F8FC"
                                  SelectionMode="Single"
                                  SelectionChanged="dgJucatori_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"         Binding="{Binding Id}"           Width="45"/>
                                <DataGridTextColumn Header="Nickname"   Binding="{Binding Nickname}"     Width="120"/>
                                <DataGridTextColumn Header="Erou"       Binding="{Binding Hero}"         Width="130"/>
                                <DataGridTextColumn Header="Rol"        Binding="{Binding Role}"         Width="110"/>
                                <DataGridTextColumn Header="Rank"       Binding="{Binding Rank}"         Width="100"/>
                                <DataGridTextColumn Header="Meciuri"    Binding="{Binding GamesPlayed}"  Width="70"/>
                                <DataGridTextColumn Header="DMG Dat"    Binding="{Binding DamageDealt}"  Width="80"/>
                                <DataGridTextColumn Header="Healing"    Binding="{Binding HealingDone}"  Width="70"/>
                                <DataGridTextColumn Header="DMG Primit" Binding="{Binding DamageTaken}"  Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button x:Name="btnModifica" Content="Modifica selectat" Width="160"
                                    Background="#E07B00" Padding="12,0"
                                    Click="btnModifica_Click" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" x:Name="borderMesaj" CornerRadius="5" Padding="12,7"
                Margin="0,6,0,0" Visibility="Collapsed">
            <TextBlock x:Name="txtMesaj" FontSize="13" FontWeight="SemiBold"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnReseteaza" Content="Reseteaza" Width="110"
                    Background="#7777AA" Padding="12,0"
                    Click="btnReseteaza_Click" Margin="0,0,10,0"/>
            <Button x:Name="btnAdauga" Content="Adauga jucator" Width="160"
                    Background="#3B3B8E" Padding="12,0"
                    Click="btnAdauga_Click"/>
        </StackPanel>

    </Grid>
</Window>
